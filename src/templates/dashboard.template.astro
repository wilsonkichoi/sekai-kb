---
import Layout from '../layouts/Layout.astro';
import '../styles/dashboard.css';
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import placeConfig from '../../place.config';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import {
  formatBytes,
  formatCount,
  formatDuration,
  formatPercent,
  formatPosition,
  resolveAnalyticsPanels,
} from '../lib/analytics-sources';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

let dashData = null;
try {
  const jsonPath = resolve(process.cwd(), 'src/data/dashboard-lite.json');
  const raw = readFileSync(jsonPath, 'utf8');
  dashData = JSON.parse(raw);
} catch {
  // Graceful degradation: JSON absent at build time
}

const available = dashData?.available === true;
const rollup = dashData?.rollup;
const immune = dashData?.immune;
const perArticle = dashData?.perArticle || [];

const categorySlugMap = new Map(placeConfig.categories.map((c) => [c.title, c.slug]));

function categoryToSlug(cat: string): string | undefined {
  return categorySlugMap.get(cat);
}

/* Analytics (ADR 012). The three source files are fetched into ignored
   src/data/analytics/ during the production build and are absent everywhere else,
   so each panel resolves to its own available/unavailable state and the article
   health sections above are unaffected by all of them. */
const analytics = resolveAnalyticsPanels(placeConfig, process.cwd());

/** `2026-08-01T04:05:06Z` -> `2026-08-01`. */
function fetchedOn(fetchedAt: string): string {
  return String(fetchedAt).slice(0, 10);
}

/** The largest value in a row set, used to scale the inline bars. Never zero. */
function peak(rows: any[], key: string): number {
  const max = rows.reduce((acc, row) => {
    const value = Number(row?.[key]);
    return Number.isFinite(value) && value > acc ? value : acc;
  }, 0);
  return max > 0 ? max : 1;
}

/** A row value's share of the peak, as a CSS width percentage. */
function barWidth(value: unknown, max: number): string {
  const n = Number(value);
  if (!Number.isFinite(n) || n <= 0) return '0%';
  return `${Math.max(2, Math.round((n / max) * 100))}%`;
}

const ga4 = analytics.sources.find((s) => s.id === 'ga4')!;
const searchConsole = analytics.sources.find((s) => s.id === 'search-console')!;
const cloudflare = analytics.sources.find((s) => s.id === 'cloudflare')!;
---

<Layout
  title={t('nav.dashboard')}
  description="Article health rollup and immune score dashboard"
>
  <main class="dashboard">
    <!-- Hero -->
    <section
      class="page-hero-dashboard-shell relative mb-4 overflow-hidden rounded-2xl bg-[linear-gradient(135deg,#1a1a2e_0%,#2d1b69_60%,#1a1a2e_100%)] p-6 text-white"
    >
      <svg
        class="pointer-events-none absolute left-0 top-1/2 h-[60px] w-full -translate-y-1/2 opacity-60"
        viewBox="0 0 600 60"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          class="ekg-line"
          d="M0,30 L120,30 L140,30 L155,8 L165,52 L175,20 L185,38 L195,30 L280,30 L300,30 L315,8 L325,52 L335,20 L345,38 L355,30 L440,30 L460,30 L475,8 L485,52 L495,20 L505,38 L515,30 L600,30"
          fill="none"
          stroke="rgba(139,92,246,0.25)"
          stroke-width="2"></path>
      </svg>
      <div class="relative">
        <h1 class="text-2xl font-bold">
          <span class="text-[1.8rem]">🔬</span> {t('nav.dashboard')}
        </h1>
        <p class="mt-1 text-sm opacity-80">Article health and immune system overview</p>
      </div>
    </section>

    {available ? (
      <>
        <!-- Vital Signs -->
        <section class="section" id="vitals">
          <h2 class="section-title">📊 Health Rollup</h2>
          <div class="vitals-grid">
            <div class="vital-card" data-vital="heartbeat">
              <div class="vital-emoji">📝</div>
              <div class="vital-value">{rollup.total}</div>
              <div class="vital-label">Articles</div>
              <div class="vital-desc">Total articles scanned</div>
            </div>
            <div class="vital-card" data-vital="cells">
              <div class="vital-emoji">✅</div>
              <div class="vital-value">{rollup.allPass}</div>
              <div class="vital-label">Passing</div>
              <div class="vital-desc">Zero hard violations</div>
            </div>
            <div class="vital-card" data-vital="immunity">
              <div class="vital-emoji">🛡️</div>
              <div class="vital-value">{rollup.passRate}%</div>
              <div class="vital-label">Pass Rate</div>
              <div class="vital-desc">Hard-check pass rate</div>
            </div>
            <div class="vital-card" data-vital="dna">
              <div class="vital-emoji">⚠️</div>
              <div class="vital-value">{rollup.totalWarn}</div>
              <div class="vital-label">Warnings</div>
              <div class="vital-desc">Total warn-level findings</div>
            </div>
            <div class="vital-card" data-vital="revision">
              <div class="vital-emoji">ℹ️</div>
              <div class="vital-value">{rollup.totalInfo}</div>
              <div class="vital-label">Info</div>
              <div class="vital-desc">Informational findings</div>
            </div>
          </div>
        </section>

        <!-- Immune System -->
        <section class="section" id="immune">
          <h2 class="section-title">🛡️ Immune Score</h2>
          <p class="section-subtitle">
            6-dimension weighted formula measuring editorial defense strength
          </p>

          <div class="immune-overview">
            <div class="immune-score-display">
              <div class="immune-score-value">{immune.score}</div>
              <div class="immune-score-label">{immune.status}</div>
            </div>
          </div>

          <h3 class="subsection-title">Dimensions</h3>
          <div class="defense-lines">
            {Object.entries(immune.components).map(([dim, val]) => {
              const weight = immune.weights[dim];
              const pct = typeof val === 'number' ? val : 0;
              const indicator = pct >= 80 ? '🟢' : pct >= 50 ? '🟡' : '🔴';
              return (
                <div class="defense-line">
                  <span class="defense-status">{indicator}</span>
                  <strong>{dim.replace(/_/g, ' ')}</strong>
                  <span class="defense-desc">
                    {Math.round(pct)}% (weight: {Math.round(weight * 100)}%)
                  </span>
                </div>
              );
            })}
          </div>
        </section>

        <!-- Article Registry -->
        <section class="section" id="registry">
          <h2 class="section-title">📋 Article Health Detail</h2>
          <p class="section-subtitle">Per-article check results from article-health</p>

          <div class="registry-table-wrapper">
            <table class="registry-table">
              <thead>
                <tr>
                  <th>Article</th>
                  <th>Category</th>
                  <th>Hard</th>
                  <th>Warn</th>
                  <th>Info</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {perArticle.map((a) => {
                  const slug = categoryToSlug(a.category);
                  return (
                    <tr>
                      <td>{slug ? <a href={`/${slug}/${a.slug}`}>{a.slug}</a> : <span>{a.slug}</span>}</td>
                      <td>{a.category}</td>
                      <td>{a.hard}</td>
                      <td>{a.warn}</td>
                      <td>{a.info}</td>
                      <td>{a.passed ? '✅' : '❌'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      </>
    ) : (
      <section class="section" data-degraded>
        <p class="section-subtitle">
          Dashboard data is not available. Run <code>npm run prebuild:dashboard</code> to generate it.
        </p>
      </section>
    )}

    {analytics.enabled && (
      <section class="section" id="analytics" data-analytics>
        <h2 class="section-title">📈 Audience signals</h2>
        <p class="section-subtitle">
          Fetched during the production build. Each source reports its own period and
          degrades on its own.
        </p>

        <!-- GA4 -->
        <div
          class="analytics-panel"
          data-analytics-source="ga4"
          data-analytics-state={ga4.available ? 'available' : 'unavailable'}
          data-analytics-reason={ga4.available ? undefined : ga4.reason}
        >
          {ga4.available ? (
            <div>
              <h3 class="subsection-title">
                {ga4.label}
                <span class="section-timestamp" data-source="analytics">
                  {ga4.data.period.start} to {ga4.data.period.end} · fetched {fetchedOn(ga4.data.fetchedAt)}
                </span>
              </h3>
              <div class="analytics-grid">
                <div class="analytics-totals">
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">👥</div>
                    <div class="ga-stat-value">{formatCount(ga4.data.summary.activeUsers)}</div>
                    <div class="ga-stat-label">Active readers</div>
                  </div>
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">✨</div>
                    <div class="ga-stat-value">{formatCount(ga4.data.summary.newUsers)}</div>
                    <div class="ga-stat-label">New readers</div>
                  </div>
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">📄</div>
                    <div class="ga-stat-value">{formatCount(ga4.data.summary.pageViews)}</div>
                    <div class="ga-stat-label">Page views</div>
                  </div>
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">🧭</div>
                    <div class="ga-stat-value">{formatCount(ga4.data.summary.sessions)}</div>
                    <div class="ga-stat-label">Sessions</div>
                  </div>
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">⏱️</div>
                    <div class="ga-stat-value">
                      {formatDuration(ga4.data.summary.averageSessionDurationSeconds)}
                    </div>
                    <div class="ga-stat-label">Avg. session</div>
                  </div>
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">🔥</div>
                    <div class="ga-stat-value">{formatPercent(ga4.data.summary.engagementRate)}</div>
                    <div class="ga-stat-label">Engagement</div>
                  </div>
                </div>
              </div>
              <div class="analytics-detail-grid">
                <div class="analytics-pages">
                  <div class="ga-block-title">Most-read pages</div>
                  {(ga4.data.topPages as any[]).slice(0, 10).map((row, i) => (
                    <div class="ga-page-row">
                      <span class="ga-page-rank">{i + 1}</span>
                      <span class="ga-page-name">{row.title || row.path}</span>
                      <span class="ga-page-pv">{formatCount(row.views)}</span>
                    </div>
                  ))}
                </div>
                <div class="analytics-sources">
                  <div class="ga-block-title">Where readers came from</div>
                  {(() => {
                    const rows = (ga4.data.trafficSources as any[]).slice(0, 8);
                    const max = peak(rows, 'sessions');
                    return rows.map((row) => (
                      <div class="ga-source-row">
                        <span class="ga-source-name">{row.sourceMedium}</span>
                        <div class="ga-source-bar-track">
                          <div class="ga-source-bar-fill" style={`width:${barWidth(row.sessions, max)}`}></div>
                        </div>
                        <span class="ga-source-count">{formatCount(row.sessions)}</span>
                      </div>
                    ));
                  })()}
                </div>
              </div>
            </div>
          ) : (
            <div class="analytics-unavailable">
              <strong>{ga4.label}</strong> is unavailable: {ga4.detail}
            </div>
          )}
        </div>

        <!-- Search Console -->
        <div
          class="analytics-panel"
          data-analytics-source="search-console"
          data-analytics-state={searchConsole.available ? 'available' : 'unavailable'}
          data-analytics-reason={searchConsole.available ? undefined : searchConsole.reason}
        >
          {searchConsole.available ? (
            <div>
              <h3 class="subsection-title">
                {searchConsole.label}
                <span class="section-timestamp" data-source="analytics">
                  {searchConsole.data.period.start} to {searchConsole.data.period.end} · fetched {fetchedOn(searchConsole.data.fetchedAt)}
                </span>
              </h3>
              <div class="analytics-grid">
                <div class="analytics-totals">
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">🖱️</div>
                    <div class="ga-stat-value">{formatCount(searchConsole.data.summary.clicks)}</div>
                    <div class="ga-stat-label">Clicks</div>
                  </div>
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">👁️</div>
                    <div class="ga-stat-value">{formatCount(searchConsole.data.summary.impressions)}</div>
                    <div class="ga-stat-label">Impressions</div>
                  </div>
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">🎯</div>
                    <div class="ga-stat-value">{formatPercent(searchConsole.data.summary.ctr)}</div>
                    <div class="ga-stat-label">Click-through</div>
                  </div>
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">📍</div>
                    <div class="ga-stat-value">
                      {formatPosition(searchConsole.data.summary.averagePosition)}
                    </div>
                    <div class="ga-stat-label">Avg. position</div>
                  </div>
                </div>
              </div>
              <div class="analytics-detail-grid">
                <div class="analytics-pages">
                  <div class="ga-block-title">Top queries</div>
                  {(searchConsole.data.topQueries as any[]).slice(0, 10).map((row, i) => (
                    <div class="sc-query-row">
                      <span class="sc-query-rank">{i + 1}</span>
                      <span class="sc-query-label">{row.query}</span>
                      <span class="sc-query-clicks">{formatCount(row.clicks)}</span>
                      <span class="sc-query-impr">{formatCount(row.impressions)}</span>
                      <span class="sc-query-ctr">{formatPercent(row.ctr)}</span>
                      <span class="sc-query-pos">{formatPosition(row.position)}</span>
                    </div>
                  ))}
                </div>
                <div class="analytics-pages">
                  <div class="ga-block-title">Top landing pages</div>
                  {(searchConsole.data.topPages as any[]).slice(0, 10).map((row, i) => (
                    <div class="ga-page-row">
                      <span class="ga-page-rank">{i + 1}</span>
                      <span class="ga-page-name">{row.url}</span>
                      <span class="ga-page-pv">{formatCount(row.clicks)}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <div class="analytics-unavailable">
              <strong>{searchConsole.label}</strong> is unavailable: {searchConsole.detail}
            </div>
          )}
        </div>

        <!-- Cloudflare -->
        <div
          class="analytics-panel"
          data-analytics-source="cloudflare"
          data-analytics-state={cloudflare.available ? 'available' : 'unavailable'}
          data-analytics-reason={cloudflare.available ? undefined : cloudflare.reason}
        >
          {cloudflare.available ? (
            <div>
              <h3 class="subsection-title">
                {cloudflare.label}
                <span class="section-timestamp" data-source="analytics">
                  {cloudflare.data.period.start} to {cloudflare.data.period.end} · fetched {fetchedOn(cloudflare.data.fetchedAt)}
                </span>
              </h3>
              <div class="analytics-grid">
                <div class="analytics-totals">
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">🌐</div>
                    <div class="ga-stat-value">{formatCount(cloudflare.data.summary.requests)}</div>
                    <div class="ga-stat-label">Requests</div>
                  </div>
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">📄</div>
                    <div class="ga-stat-value">{formatCount(cloudflare.data.summary.pageViews)}</div>
                    <div class="ga-stat-label">Page views</div>
                  </div>
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">🚶</div>
                    <div class="ga-stat-value">{formatCount(cloudflare.data.summary.visits)}</div>
                    <div class="ga-stat-label">Visits</div>
                  </div>
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">📦</div>
                    <div class="ga-stat-value" data-bytes={cloudflare.data.summary.bytes}>
                      {formatBytes(cloudflare.data.summary.bytes)}
                    </div>
                    <div class="ga-stat-label">Served</div>
                  </div>
                  <div class="ga-stat-card">
                    <div class="ga-stat-icon">🛡️</div>
                    <div class="ga-stat-value">{formatCount(cloudflare.data.summary.threats)}</div>
                    <div class="ga-stat-label">Threats blocked</div>
                  </div>
                </div>
              </div>
              <div class="analytics-detail-grid">
                <div class="analytics-countries">
                  <div class="ga-block-title">Top countries</div>
                  {(() => {
                    const rows = (cloudflare.data.topCountries as any[]).slice(0, 10);
                    const max = peak(rows, 'requests');
                    return rows.map((row) => (
                      <div class="ga-country-row">
                        <span class="ga-country-name">{row.country}</span>
                        <div class="ga-country-bar-track">
                          <div class="ga-country-bar-fill" style={`width:${barWidth(row.requests, max)}`}></div>
                        </div>
                        <span class="ga-country-count">{formatCount(row.requests)}</span>
                      </div>
                    ));
                  })()}
                </div>
                <div class="analytics-sources">
                  <div class="ga-block-title">Response status</div>
                  {(() => {
                    const rows = (cloudflare.data.statusCodes as any[]).slice(0, 10);
                    const max = peak(rows, 'requests');
                    return rows.map((row) => (
                      <div class="ga-source-row">
                        <span class="ga-source-name">{row.status}</span>
                        <div class="ga-source-bar-track">
                          <div class="ga-source-bar-fill" style={`width:${barWidth(row.requests, max)}`}></div>
                        </div>
                        <span class="ga-source-count">{formatCount(row.requests)}</span>
                      </div>
                    ));
                  })()}
                </div>
              </div>
            </div>
          ) : (
            <div class="analytics-unavailable">
              <strong>{cloudflare.label}</strong> is unavailable: {cloudflare.detail}
            </div>
          )}
        </div>
      </section>
    )}

    <footer class="dashboard-footer">
      {available && dashData.generated && (
        <p>Generated: {dashData.generated.slice(0, 10)}</p>
      )}
    </footer>
  </main>
</Layout>

<style>
  .immune-overview {
    display: flex;
    justify-content: center;
    margin: 1.5rem 0;
  }
  .immune-score-display {
    text-align: center;
    padding: 1.5rem 2.5rem;
    background: var(--color-surface-raised);
    backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }
  .immune-score-value {
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-ink);
    line-height: 1.1;
  }
  .immune-score-label {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    margin-top: 0.3rem;
    font-weight: 500;
  }
  .defense-status {
    flex-shrink: 0;
    font-size: 1rem;
  }
</style>
